{
  "name": "clearspace-monorepo",
  "version": "0.4.0",
  "private": true,
  "workspaces": [
    "apps/desktop",
    "apps/web"
  ],
  "scripts": {
    "dev:desktop": "npm --workspace=apps/desktop run tauri dev",
    "build:desktop": "npm --workspace=apps/desktop run tauri build",
    "dev:web": "npm --workspace=apps/web run dev",
    "build:web": "npm --workspace=apps/web run build",
    "preview:web": "npm --workspace=apps/web run preview",
    "sync:downloads": "node apps/web/scripts/sync-downloads.mjs",
    "version:sync": "node scripts/sync-version.mjs sync",
    "version:bump": "node scripts/sync-version.mjs",
    "test:rust": "node apps/desktop/scripts/run-tauri.mjs --cargo test --workspace"
  }
}
