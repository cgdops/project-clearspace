{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Clearspace",
  "version": "0.1.0",
  "identifier": "com.g3zcreative.clearspace",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "Clearspace — Zero-Knowledge Career & Cognitive Compass",
        "width": 1340,
        "height": 880,
        "minWidth": 1024,
        "minHeight": 700,
        "resizable": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/icon.ico",
      "icons/icon.png"
    ]
  }
}
